{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array", "minItems": 1,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "family", "availability", "reason", "requiredCapabilities"],
    "properties": {
      "id": {"type": "string", "pattern": "^PARITY-[a-z0-9-]+$", "maxLength": 64},
      "family": {"type": "string"},
      "availability": {"enum": ["local", "unavailable", "deferred"]},
      "reason": {"type": "string", "minLength": 1},
      "requiredCapabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "requests": {
        "type": "array", "minItems": 1, "maxItems": 16,
        "items": {
          "type": "object", "additionalProperties": false, "required": ["mode"],
          "properties": {
            "mode": {"enum": ["created", "no-content", "application-error", "empty"]},
            "method": {"enum": ["POST"]},
            "path": {"enum": ["/parity/a", "/parity/b"]},
            "body": {"type": ["string", "null"], "maxLength": 4096},
            "base64": {"const": false},
            "headers": {"type": "object", "additionalProperties": false, "properties": {
              "x-synthetic": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 128}}
            }},
            "query": {"type": "object", "additionalProperties": false, "properties": {
              "q": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 128}},
              "empty": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 128}}
            }}
          }
        }
      }
    },
    "allOf": [{"if": {"properties": {"availability": {"const": "local"}}}, "then": {"required": ["requests"]}}]
  }
}
