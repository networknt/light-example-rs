# Copy to a private file and replace every placeholder. Do not source as a script.
TRIAGE_IMAGE=networknt/demo-support-triage-agent:0.1.0-local-triage
LIGHT_A2A_IMAGE=networknt/light-a2a:YOUR_BUILT_TAG
TRIAGE_PORTAL_NETWORK=YOUR_PORTAL_NETWORK
TRIAGE_BACKEND_CONFIG=/absolute/private/backend.json
TRIAGE_A2A_CONFIG_DIR=/absolute/private/a2a-config
TRIAGE_SECRETS_DIR=/absolute/private/secrets
TRIAGE_CA_FILE=/absolute/private/ca.pem
TRIAGE_A2A_PORT=8458
TRIAGE_LIGHT_PORTAL_AUTHORIZATION=
